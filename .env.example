# Set these through the hosted environment settings, never in source control.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook endpoint: /api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted
# Enable cancellation and payment method updates in the Stripe Customer Portal.

# SmartQR independent OIDC (managed Auth0 Universal Login or compatible provider)
SMARTQR_PUBLIC_ORIGIN=https://qr.cotiso.co.uk
SMARTQR_OIDC_ISSUER=
SMARTQR_OIDC_CLIENT_ID=
SMARTQR_OIDC_CLIENT_SECRET=
SMARTQR_SESSION_SECRET=
# Restrict dynamic beta to this verified provider email
SUPPORT_ADMIN_EMAIL=
